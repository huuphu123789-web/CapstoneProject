--- !u!114 &725120245
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 919132148945149175}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: aa084dc2b82ee7c42a46a20dd189693b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HandbookInteractable
  handbookTitle: "S\u1ED4 TAY CHI\u1EBEN S\u0128"
  pages:
  - pageTitle: "NHI\u1EC6M V\u1EE4 & QUY T\u1EAEC"
    pageContent: "1. Lu\xF4n tu\xE2n th\u1EE7 l\u1EC7nh ch\u1EC9 huy.\n2. Kh\xF4ng
      \u0111\u1EC3 b\u1EA5t k\u1EF3 ai qua tr\u1EA1m\n   khi ch\u01B0a ki\u1EC3m
      tra gi\u1EA5y t\u1EDD.\n3. B\xE1o c\xE1o ngay m\u1ECDi ho\u1EA1t \u0111\u1ED9ng\n  
      kh\u1EA3 nghi qua b\u1ED9 \u0111\xE0m.\n4. Kh\xF4ng \u0111\u01B0\u1EE3c r\u1EDDi
      v\u1ECB tr\xED khi\n   ch\u01B0a c\xF3 ng\u01B0\u1EDDi thay ca.\n5. V\u0169
      kh\xED lu\xF4n trong t\xECnh tr\u1EA1ng\n   s\u1EB5n s\xE0ng chi\u1EBFn \u0111\u1EA5u."
  - pageTitle: "KHU V\u1EF0C & V\u1ECA TR\xCD"
    pageContent: "\u25BA Khu A  \u2013 C\u1ED5ng ch\xEDnh\n\u25BA Khu B  \u2013 Kho
      v\u0169 kh\xED\n\u25BA Khu C  \u2013 Tr\u1EA1i giam gi\u1EEF\n\u25BA Khu D 
      \u2013 \u0110\xE0i quan s\xE1t\n\n\u26A0 Khu v\u1EF1c C v\xE0 D\n   CH\u1EC8
      d\xE0nh cho c\u1EA5p tr\xEAn.\n   Kh\xF4ng \u0111\u01B0\u1EE3c ti\u1EBFp c\u1EADn\n  
      khi ch\u01B0a c\xF3 l\u1EC7nh."
  - pageTitle: "T\xCDN HI\u1EC6U KH\u1EA8N C\u1EA4P"
    pageContent: "\U0001F534 \u0110\u1ECE   \u2013 B\xE1o \u0111\u1ED9ng t\u1EA5n
      c\xF4ng\n\U0001F7E1 V\xC0NG \u2013 C\u1EA3nh b\xE1o x\xE2m nh\u1EADp\n\U0001F7E2
      XANH \u2013 Tr\u1EA1ng th\xE1i b\xECnh th\u01B0\u1EDDng\n\nKhi nghe c\xF2i
      3 ti\u1EBFng:\n\u2192 V\u1EC1 v\u1ECB tr\xED ph\xF2ng th\u1EE7 ngay!\n\nKhi
      nghe c\xF2i li\xEAn t\u1EE5c:\n\u2192 Di t\u1EA3n theo l\u1ED9 tr\xECnh B."
  - pageTitle: "LI\xCAN L\u1EA0C & B\xC1O C\xC1O"
    pageContent: "T\u1EA7n s\u1ED1 b\u1ED9 \u0111\xE0m ch\xEDnh: 87.5 MHz\nT\u1EA7n
      s\u1ED1 d\u1EF1 ph\xF2ng  : 102.3 MHz\n\nB\xE1o c\xE1o ca: m\u1ED7i 2 gi\u1EDD
      m\u1ED9t l\u1EA7n.\n\nM\u1EADt kh\u1EA9u \u0111\xEAm nay:\n\"BI\xCAN C\u01AF\u01A0NG\"\n\nPh\u1EA3n
      h\u1ED3i m\u1EADt kh\u1EA9u:\n\"T\u1ED4 QU\u1ED0C\""
  coverColor: {r: 0.22, g: 0.28, b: 0.18, a: 1}
  paperColor: {r: 0.93, g: 0.89, b: 0.78, a: 1}
  titleColor: {r: 0.12, g: 0.08, b: 0.04, a: 1}
  contentColor: {r: 0.15, g: 0.12, b: 0.08, a: 1}
  accentColor: {r: 0.55, g: 0.12, b: 0.08, a: 1}
  fontAsset: {fileID: 0}
  flipSound: {fileID: 0}
  openSound: {fileID: 0}
  _prompt: "Xem s\u1ED5 tay"
